local espOn = false
local espBills = {}
local function espClear()
	for _, b in pairs(espBills) do pcall(function() b:Destroy() end) end
	espBills = {}
end
local function espMake(p)
	if p == lp then return end
	local char = p.Character
	local head = char and char:FindFirstChild("Head")
	if not head then return end
	local bb = Instance.new("BillboardGui")
	bb.Name = "_LuxESP"
	bb.AlwaysOnTop = true
	bb.Size = UDim2.new(0, 120, 0, 36)
	bb.StudsOffset = Vector3.new(0, 2.4, 0)
	bb.Adornee = head
	bb.Parent = head
	local lbl = Instance.new("TextLabel")
	lbl.BackgroundTransparency = 1
	lbl.Size = UDim2.new(1, 0, 1, 0)
	lbl.Font = Enum.Font.GothamBold
	lbl.TextSize = 13
	lbl.TextColor3 = Color3.fromRGB(220, 80, 80)
	lbl.TextStrokeTransparency = 0.3
	lbl.TextStrokeColor3 = Color3.new(0, 0, 0)
	lbl.Text = p.Name
	lbl.Parent = bb
	espBills[p] = bb
end
local function espRebuild()
	espClear()
	if not espOn then return end
	for _, p in ipairs(Players:GetPlayers()) do espMake(p) end
end
task.spawn(function()
	while not closed do
		task.wait(0.5)
		if not espOn then continue end
		local myRoot = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
		for p, bb in pairs(espBills) do
			if not bb.Parent then
				espMake(p)
			else
				local pChar = p.Character
				local pRoot = pChar and pChar:FindFirstChild("HumanoidRootPart")
				local lbl2 = bb:FindFirstChildOfClass("TextLabel")
				if lbl2 and pRoot and myRoot then
					local d = math.floor((pRoot.Position - myRoot.Position).Magnitude + 0.5)
					lbl2.Text = p.Name .. "\n" .. d .. "m"
					lbl2.TextColor3 = pChar:FindFirstChildOfClass("Tool")
						and Color3.fromRGB(255, 60, 60)
						or  Color3.fromRGB(80, 220, 255)
				end
			end
		end
	end
end)
table.insert(conns, Players.PlayerAdded:Connect(function(p)
	if espOn then p.CharacterAdded:Connect(function() task.wait(1); espMake(p) end) end
end))
table.insert(conns, Players.PlayerRemoving:Connect(function(p)
	local b = espBills[p]
	if b then pcall(function() b:Destroy() end); espBills[p] = nil end
end))

