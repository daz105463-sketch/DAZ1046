local function makeRing(size, thick, trans)
	local ring = Instance.new("Frame")
	ring.AnchorPoint = Vector2.new(0.5, 0.5)
	ring.Position = UDim2.new(0.5, 0, 0.42, 0)
	ring.Size = UDim2.new(0, size, 0, size)
	ring.BackgroundTransparency = 1
	ring.Parent = load
	local cr = Instance.new("UICorner")
	cr.CornerRadius = UDim.new(0, size / 2)
	cr.Parent = ring
	local st = Instance.new("UIStroke")
	st.Color = Color3.fromRGB(255, 60, 100)
	st.Thickness = thick
	st.Transparency = trans
	st.Parent = ring
	for i = 1, 10 do
		local dot = Instance.new("Frame")
		dot.Size = UDim2.new(0, 4, 0, 4)
		dot.BackgroundColor3 = Color3.fromRGB(255, 120, 150)
		dot.BackgroundTransparency = 0.2
		dot.Parent = ring
		local cd = Instance.new("UICorner")
		cd.CornerRadius = UDim.new(0, 2)
		cd.Parent = dot
		local ang = (i / 10) * math.pi * 2
		dot.Position = UDim2.new(0.5 + math.cos(ang) * 0.48, -2, 0.5 + math.sin(ang) * 0.48, -2)
	end
	local bigDot = Instance.new("Frame")
	bigDot.Size = UDim2.new(0, 8, 0, 8)
	bigDot.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	bigDot.Parent = ring
	local cb = Instance.new("UICorner")
	cb.CornerRadius = UDim.new(0, 4)
	cb.Parent = bigDot
	bigDot.Position = UDim2.new(0.5, -4, 0, -4)
	return ring
end

