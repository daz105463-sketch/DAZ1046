-- AutoThrow: يرمي القنبلة بعد N ثانية من الحمل (ينقلها للحقيبة)
local autoThrowOn = false
local autoThrowSec = 3
local _throwPickup = 0
local _hadToolThrow = false
task.spawn(function()
	while not closed do
		RunService.Heartbeat:Wait()
		if not autoThrowOn then _hadToolThrow = false; continue end
		local char = lp.Character
		if not char then continue end
		local tool = char:FindFirstChildOfClass("Tool")
		if tool and not _hadToolThrow then
			_throwPickup = os.clock()
			_hadToolThrow = true
		elseif not tool then
			_hadToolThrow = false
		end
		if tool and _hadToolThrow and (os.clock() - _throwPickup) >= autoThrowSec then
			pcall(function()
				local bp = lp:FindFirstChildOfClass("Backpack")
				if bp then tool.Parent = bp end
			end)
			_hadToolThrow = false
		end
	end
end)

-- SpeedBurst: يرفع سرعتك فجأة لما تاخذ الأداة ثم يرجعها
local speedBurstOn = false
local speedBurstMul = 2.0
local _burstActive = false
local _origWalkSpeed = nil
task.spawn(function()
	while not closed do
		RunService.Heartbeat:Wait()
		if not speedBurstOn then
			if _burstActive then
				local char = lp.Character
				local hum = char and char:FindFirstChildOfClass("Humanoid")
				if hum and _origWalkSpeed then hum.WalkSpeed = _origWalkSpeed end
				_burstActive = false
			end
			continue
		end
		local char = lp.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if not hum then continue end
		local hasTool = char:FindFirstChildOfClass("Tool") ~= nil
		local now = os.clock()
		if hasTool and not _burstActive then
			_origWalkSpeed = hum.WalkSpeed
			hum.WalkSpeed = (_origWalkSpeed or 16) * speedBurstMul
			_burstActive = true
		elseif _burstActive and not hasTool then
			if _origWalkSpeed then hum.WalkSpeed = _origWalkSpeed end
			_burstActive = false
		end
	end
end)

-- HighJump [F]: نطة مضاعفة واحدة عند الضغط على F
local highJumpOn = false
local highJumpMul = 2.5
local function doHighJump()
	if not highJumpOn then return end
	local char = lp.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not hum or not root or hum.Health <= 0 then return end
	if hum.FloorMaterial == Enum.Material.Air then return end
	local power = hum.UseJumpPower and hum.JumpPower or math.sqrt(2 * workspace.Gravity * hum.JumpHeight)
	power = power * highJumpMul
	hum.Jump = true
	pcall(function() hum:ChangeState(Enum.HumanoidStateType.Jumping) end)
	local v = root.AssemblyLinearVelocity
	root.AssemblyLinearVelocity = Vector3.new(v.X, power, v.Z)
end
table.insert(conns, UserInputService.InputBegan:Connect(function(inp, gpe)
	if gpe or not highJumpOn then return end
	if inp.KeyCode == Enum.KeyCode.F then doHighJump() end
end))

-- TpNearest [G]: تيليبورت فوري للخصم الأقرب
local tpNearestKey = Enum.KeyCode.G
local function doTpNearest()
	local char = lp.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not root or not hum or hum.Health <= 0 then return end
	local best, bd = nil, math.huge
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= lp and not isTeammate(p) then
			local pc = p.Character
			local pr = pc and pc:FindFirstChild("HumanoidRootPart")
			local ph = pc and pc:FindFirstChildOfClass("Humanoid")
			if pr and ph and ph.Health > 0 then
				local d = (pr.Position - root.Position).Magnitude
				if d < bd then best, bd = pr, d end
			end
		end
	end
	if best then
		local off = root.Position - best.Position
		local dir = off.Magnitude > 0.1 and off.Unit or Vector3.new(0, 0, 1)
		root.CFrame = CFrame.new(best.Position + dir * 2.8 + Vector3.new(0, 0.5, 0))
	end
end
table.insert(conns, UserInputService.InputBegan:Connect(function(inp, gpe)
	if gpe then return end
	if inp.KeyCode == tpNearestKey then doTpNearest() end
end))

