local BTN_SND_IDS = {
	"rbxassetid://9118828568",  -- click 1
	"rbxassetid://7257680621",  -- click 2 (soft key)
	"rbxassetid://8755375784",  -- click 3 (clack)
}
local _sndPool = {}
local _sndPoolIdx = 0
local function _poolSound()
	_sndPoolIdx = (_sndPoolIdx % #BTN_SND_IDS) + 1
	local s = _sndPool[_sndPoolIdx]
	if not s or not s.Parent then
		s = Instance.new("Sound")
		s.SoundId = BTN_SND_IDS[_sndPoolIdx]
		s.Volume = 0.38
		s.Parent = SoundService
		_sndPool[_sndPoolIdx] = s
	end
	return s
end
local function clickSnd()
	local s = _poolSound()
	s.PlaybackSpeed = 0.92 + math.random() * 0.16  -- slight pitch variation
	s:Play()
end
local function openSnd()
	local s = Instance.new("Sound")
	s.SoundId = "rbxassetid://4569070637"
	s.Volume = 0.3
	s.Parent = SoundService
	s:Play()
	game:GetService("Debris"):AddItem(s, 1)
end

